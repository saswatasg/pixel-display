<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pixelbridge.idotmatrix</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>__APP_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Self-heal: launchd re-runs `open -g` every 5 minutes. While the app is
         running this is a harmless no-op; after a wake/sleep crash of the
         bridge it relaunches the wrapper, which restarts uvicorn. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__BRIDGE_DIR__/logs/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>__BRIDGE_DIR__/logs/bridge-error.log</string>
</dict>
</plist>